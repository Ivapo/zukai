{
  "name": "zukai",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "wasm": "wasm-pack build src-tauri --target web --out-dir pkg --no-pack",
    "predev": "bun run wasm",
    "dev": "vite",
    "prebuild": "bun run wasm",
    "build": "tsc && vite build",
    "build:web": "bun run build --base=/zukai/",
    "preview": "vite preview",
    "prerender-examples": "bun run build",
    "render-examples": "bun run scripts/render-examples.ts",
    "pretest": "bun run wasm",
    "test": "vitest run",
    "tauri": "tauri"
  },
  "dependencies": {
    "@fontsource/overpass": "^5.3.0",
    "@fontsource/overpass-mono": "^5.3.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-opener": "^2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/node": "^26.2.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "playwright": "^1.62.1",
    "typescript": "~5.8.3",
    "vite": "^7.0.4",
    "vitest": "^4.1.10"
  }
}
